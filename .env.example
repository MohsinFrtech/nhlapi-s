NHL_API_URL=https://nhl-api5.p.rapidapi.com
NHL_API_HOST=nhl-api5.p.rapidapi.com
NHL_API_TOKEN=your-rapidapi-key

# Optional. Without these the app uses per-instance memory only (fine locally). On Vercel, connecting
# Upstash Redis from the Marketplace adds them automatically.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Stop calling RapidAPI after this many calls in a calendar month (needs Redis). Default 22000.
# UPSTREAM_MONTHLY_LIMIT=22000
